  "source": "pragma cashscript ^0.13.0;\n\n// Grant funds remain locked until a public block height. Only the beneficiary can withdraw.\ncontract OpenGrant(pubkey beneficiary, int unlockHeight) {\n    function release(sig beneficiarySignature) {\n        require(tx.time >= unlockHeight);\n        require(checkSig(beneficiarySignature, beneficiary));\n    }\n}\r\n",
